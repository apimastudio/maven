  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.apima.lumaris</groupId>
  <artifactId>lumaris-agora</artifactId>
  <version>0.3.1</version>
  <packaging>aar</packaging>
  <name>Lumaris Agora</name>
  <description>Publishes Lumaris's makeup-filtered video and delay-matched microphone into an Agora call. Optional: the core SDK links no call provider.</description>
  <url>https://apimastudio.com</url>
  <licenses>
    <license>
      <name>Commercial</name>
      <url>https://apimastudio.com/terms</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>apima</id>
      <name>Apima</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/muratdoglu/lumaris-android-native.git</connection>
    <url>https://github.com/muratdoglu/lumaris-android-native</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.apima.lumaris</groupId>
      <artifactId>lumaris</artifactId>
      <version>0.3.1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.agora.rtc</groupId>
      <artifactId>full-sdk</artifactId>
      <version>4.6.3</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.2.20</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>androidx.core</groupId>
      <artifactId>core-ktx</artifactId>
      <version>1.15.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>androidx.lifecycle</groupId>
      <artifactId>lifecycle-runtime-ktx</artifactId>
      <version>2.9.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
